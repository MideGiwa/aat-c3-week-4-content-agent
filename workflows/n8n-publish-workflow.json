    },
    {
      "id": "notify-x-failed-1",
      "name": "Notify Discord (X Failed)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [2620, 180],
      "parameters": {
        "connectionType": "webhook",
        "content": "={{ '🔴 X publish failed (request ' + $('Route By Channel').item.json.request_id + '): ' + $json.error.message }}"
      },
      "credentials": {
        "discordWebhookApi": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Content Ops Discord Webhook" }
      }
    },
    {
      "id": "noop-fallback-1",
      "name": "Unknown Channel (Skip)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1740, 380],
      "parameters": {}
    },
    {
      "id": "noop-done-1",
      "name": "Run Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1080, 380],
      "parameters": {}
    },
    {
      "id": "check-failure-rate-1",
      "name": "Check Failure Rate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1300, 380],
      "notes": "Closes the 'credential expiry alerting' gap flagged in the earlier hardening review: if a channel has racked up 3+ failures in the last hour, that's very likely an expired credential or a persistent API/rate-limit problem, not one-off bad luck — worth a human looking rather than quietly failing every 5 minutes.",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT stage, COUNT(*) AS failures\nFROM stage_logs\nWHERE status = 'failed'\n  AND stage IN ('publish_linkedin', 'publish_x')\n  AND created_at > NOW() - INTERVAL '1 hour'\nGROUP BY stage\nHAVING COUNT(*) >= 3;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "id": "notify-repeated-failures-1",
      "name": "Notify Discord (Repeated Failures)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1520, 380],
      "parameters": {
        "connectionType": "webhook",
        "content": "={{ '🚨 ' + $json.stage + ' has failed ' + $json.failures + ' time(s) in the last hour — likely a credential, auth, or rate-limit issue. Check stage_logs and the credential in n8n.' }}"
      },
      "credentials": {
        "discordWebhookApi": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Content Ops Discord Webhook" }
      }
    }
  ],
